# Ambiente virtual do Python e caches de bytecode
__pycache__/
.venv/
venv/
*.pyc
.env
cls

# Backups gerados pelo reversa-docs
_reversa_docs/.backup-*/

# Lixo de execucao do harness de paridade (_reversa_sdd/parity/)
.parity-run-oracle/
.parity-tmp/
.pytest-tmp/
tests/.tmp/
.parity-run-cand/
_reversa_sdd/parity/_obs_*.json
_reversa_sdd/parity/_collect_*.py

# Logs de execução da aplicação (feature 049). O que sai aqui é dado de operação, e o
# volume do compose publica ./logs. Nunca versionar.
logs/

# Backups e caches genericos
.backup-*
.reversa/snapshots/
.pytest_cache/
.coverage
htmlcov/

# Dados reais do usuario: GEDCOM e CSV de DNA nunca sao versionados (principio I).
# O padrao com barra final casa em qualquer profundidade, cobrindo
# uploads/ e analisador-genealogico/uploads/.
**/uploads/*
!src/uploads/.gitkeep

# Backups de dado do operador gravados pelo Reversa (principio I).
.reversa/backups-de-dados/

# Diretorio de trabalho do _docs_render_check.js
.reversa/_tmp_scripts/

# Ferramenta local de publicação do mini-site (não versionar).
publicar_docs.py
