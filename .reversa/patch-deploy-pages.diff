+          rm -f  _reversa_docs/.state.json
+          rm -f  _reversa_docs/.config.json
+          rm -f  _reversa_docs/assets/data/*.json
+          touch  _reversa_docs/.nojekyll
+          echo "Conteudo a publicar:"
+          find _reversa_docs -type f | wc -l
+          du -sh _reversa_docs
+
