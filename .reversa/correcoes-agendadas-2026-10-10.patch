+"""O cache de nomes do modulo documental invalida por CONTEUDO (`L-24` / `E-05`).
+
+## O defeito, e por que este arquivo existe
+
+O indice `nome -> ids` e um **cache de modulo**. A chave de invalidacao era
+`(len(people), chaves[0], chaves[-1])`: duas arvores do **mesmo tamanho** e com os
+**mesmos xrefs extremos** compartilhavam o indice, e o dossie de homonimos da
+SEGUNDA citava um xref que **nao existe nela** — sem levantar nada, porque
+`get_name(None)` devolve `"Sem Nome"` e as consultas devolvem `[]`/`None`.
+
+O cenario era **inferido** ate 2026-10-10, quando foi **confirmado por execucao**
+na revisao da re-extracao. E o gatilho medido **nao depende do conteudo**: as duas
+arvores reais pequenas da pasta do operador ja compartilhavam os dois extremos
+(`@I1000@` e `@I9@`) e diferiam **apenas** no tamanho.
+
+## O que estes testes prendem
+
+Eles prendem o **defeito**, e nao a forma da chave: qualquer implementacao que
+invalide por conteudo passa, e qualquer uma que volte a invalidar por tamanho e
+extremos cai. Os dois primeiros **falhavam antes da correcao**.
+
+O segundo cobre o caso **mais provavel dos dois**, e o que quase escapou da
+correcao: o operador corrigir o nome de uma pessoa e reexportar a mesma arvore —
+mesmo conjunto de xrefs, nomes diferentes. Invalidar so pelas chaves nao bastaria.
+"""
+from __future__ import annotations
+
+import os
+import sys
+import tempfile
+
+import pytest
+
+RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, os.path.join(RAIZ, "src"))
+
+from parsers import gedcom_parser  # noqa: E402
+from core import documentary_relationship as dr  # noqa: E402
+
+# Duas arvores de QUATRO pessoas cada, com os MESMOS extremos (`@I1@` e `@I9@`) e
+# xrefs interiores diferentes. A chave antiga era identica para as duas.
+ARVORE_A = """0 HEAD
+1 GEDC
+2 VERS 5.5.1
+0 @I1@ INDI
+1 NAME Ana /Silva/
+0 @I2@ INDI
+1 NAME Joao /Silva/
+0 @I3@ INDI
+1 NAME Rita /Silva/
+0 @I9@ INDI
+1 NAME Ze /Silva/
+0 TRLR
+"""
+
+ARVORE_B = """0 HEAD
+1 GEDC
+2 VERS 5.5.1
+0 @I1@ INDI
+1 NAME Ana /Souza/
+0 @I4@ INDI
+1 NAME Pedro /Souza/
+0 @I5@ INDI
+1 NAME Clara /Souza/
+0 @I9@ INDI
+1 NAME Ze /Souza/
+0 TRLR
+"""
+
+# Mesmo conjunto de xrefs; so o NOME de `@I1@` muda. E o caso do operador que
+# corrige um nome e reexporta a arvore.
+RENOMEADA_A = """0 HEAD
+1 GEDC
+2 VERS 5.5.1
+0 @I1@ INDI
+1 NAME Joao /Silva/
+0 @I2@ INDI
+1 NAME Maria /Silva/
+0 TRLR
+"""
+
+RENOMEADA_B = """0 HEAD
+1 GEDC
+2 VERS 5.5.1
+0 @I1@ INDI
+1 NAME Pedro /Souza/
+0 @I2@ INDI
+1 NAME Maria /Silva/
+0 TRLR
+"""
+
+
+def _gravar(conteudo: str, sufixo=".ged"):
+    fd, caminho = tempfile.mkstemp(suffix=sufixo)
+    with os.fdopen(fd, "w", encoding="utf-8") as fh:
+        fh.write(conteudo)
+    return caminho
+
+
+@pytest.fixture()
+def duas_arvores():
+    caminhos = [_gravar(ARVORE_A), _gravar(ARVORE_B)]
+    yield caminhos
+    for caminho in caminhos:
+        try:
+            os.unlink(caminho)
+        except OSError:
+            pass
+
+
+@pytest.fixture()
+def arvore_renomeada():
+    caminhos = [_gravar(RENOMEADA_A), _gravar(RENOMEADA_B)]
+    yield caminhos
+    for caminho in caminhos:
+        try:
+            os.unlink(caminho)
+        except OSError:
+            pass
+
+
+def _ids_citados(dossie: dict) -> list:
+    ids = []
+    for valor in dossie.values():
+        if isinstance(valor, list):
+            for item in valor:
+                if isinstance(item, dict) and "id" in item:
+                    ids.append(item["id"])
+    return ids
+
+
+def test_arvores_de_mesmo_tamanho_e_extremos_nao_compartilham_o_indice(duas_arvores):
+    """O caso medido em 2026-10-10 — este teste FALHAVA antes da correcao."""
+    a = gedcom_parser.carregar_arvore(duas_arvores[0])
+    b = gedcom_parser.carregar_arvore(duas_arvores[1])
+
+    assert len(a[0]) == len(b[0]) == 4
+    assert sorted(a[0])[0] == sorted(b[0])[0] == "@I1@"
+    assert sorted(a[0])[-1] == sorted(b[0])[-1] == "@I9@"
+
+    # A primeira arvore aquece o cache.
+    assert dr.homonym_dossier(a, "Joao Silva")["exact_count"] == 1
+
+    # A segunda NAO tem nenhum "Joao", e nao pode herdar o indice da primeira.
+    dossie_b = dr.homonym_dossier(b, "Joao Silva")
+    assert dossie_b["exact_count"] == 0, (
+        "o dossie da segunda arvore citou um nome que so existe na primeira"
+    )
+    for pid in _ids_citados(dossie_b):
+        assert pid in b[0], f"o dossie citou {pid}, que nao existe na arvore carregada"
+
+
+def test_mesmos_xrefs_com_nomes_diferentes_invalidam_o_indice(arvore_renomeada):
+    """O caso mais provavel: o operador renomeia e reexporta a MESMA arvore.
+
+    Invalidar so pelas chaves nao bastaria — o conjunto de xrefs e identico aqui.
+    """
+    a = gedcom_parser.carregar_arvore(arvore_renomeada[0])
+    b = gedcom_parser.carregar_arvore(arvore_renomeada[1])
+
+    assert sorted(a[0]) == sorted(b[0]), "o teste so vale com o conjunto de xrefs igual"
+
+    assert dr.homonym_dossier(a, "Joao Silva")["exact_count"] == 1
+
+    dossie_b = dr.homonym_dossier(b, "Joao Silva")
+    assert dossie_b["exact_count"] == 0, (
+        "o indice sobreviveu a troca de nomes com os xrefs iguais"
+    )
+    assert dr.homonym_dossier(b, "Pedro Souza")["exact_count"] == 1
+
+
+def test_a_chave_muda_quando_o_conteudo_muda(duas_arvores, arvore_renomeada):
+    """A chave e funcao do conteudo — nas duas formas de diferenca."""
+    a, b = (gedcom_parser.carregar_arvore(c)[0] for c in duas_arvores)
+    ra, rb = (gedcom_parser.carregar_arvore(c)[0] for c in arvore_renomeada)
+
+    assert dr._chave_de(a) != dr._chave_de(b), "xrefs interiores diferentes"
+    assert dr._chave_de(ra) != dr._chave_de(rb), "nomes diferentes com os mesmos xrefs"
+    assert dr._chave_de(a) == dr._chave_de(a), "a chave tem de ser estavel para o mesmo conteudo"
+    assert dr._chave_de({}) == (0, None, None, "")
+
+
+def test_o_indice_continua_sendo_reaproveitado_para_a_mesma_arvore(duas_arvores):
+    """A correcao nao pode ter matado o cache — era ele que evitava 71 varreduras."""
+    a = gedcom_parser.carregar_arvore(duas_arvores[0])
+
+    primeiro = dr._indice_por_nome(a)
+    segundo = dr._indice_por_nome(a)
+
+    assert primeiro is segundo, "o mapa foi reconstruido para a mesma arvore"
