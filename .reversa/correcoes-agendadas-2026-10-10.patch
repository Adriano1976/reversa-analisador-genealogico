+"""Ordenacao deterministica dos ancestrais comuns (`L-25`).
+
+## O defeito
+
+`find_all_common_ancestors` varre `set(de_a) & set(de_b)` e ordena por
+`(meioses totais, maior distancia, nome)`. Quando **dois ancestrais empatam nos TRES
+criterios**, a ordem final era a da iteracao do conjunto — que muda com o
+`PYTHONHASHSEED`, isto e, entre execucoes do mesmo codigo. `additional_paths` e a
+lista de colapso derivam dessa ordem, entao herdavam a instabilidade.
+
+E a **mesma classe** do defeito que o `matching` de `analise-dna` fechou em
+2026-10-05 com um quarto criterio deterministico — o menor `xref_id` (`BR-D-63`).
+A correcao de 2026-10-10 aplica aqui o mesmo desenho, deliberadamente.
+
+## O que este teste prende
+
+A **ordem por `xref_id` no empate triplo**, e nao o texto da chave. Duas arvores
+LOGICAMENTE identicas sao montadas com a declaracao dos ancestrais em ordens
+trocadas; as duas tem de devolver a MESMA lista, na ordem dos ids.
+
+> **Nota de honestidade:** um defeito de ordem de `set` pode passar por sorte dentro
+> de um unico processo. Por isso o teste nao depende de semente: ele fixa o contrato
+> (no empate, o menor `xref_id` vence) e o confere nas duas declaracoes.
+"""
+from __future__ import annotations
+
+import os
+import sys
+import tempfile
+
+import pytest
+
+RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, os.path.join(RAIZ, "src"))
+
+from parsers import gedcom_parser  # noqa: E402
+from core import documentary_relationship as dr  # noqa: E402
+
+# `@I1@` e `@I2@` descendem, os DOIS, de `@I10@` e de `@I20@`, a distancia 2 de
+# cada lado. Os dois ancestrais se chamam "Joao Silva". Resultado: empate exato em
+# meioses (4), maior distancia (2) e nome — o que sobra e o `xref_id`.
+_CABECA = """0 HEAD
+1 GEDC
+2 VERS 5.5.1
+"""
+
+_CORPO_ANCESTRAIS = """0 {primeiro} INDI
+1 NAME Joao /Silva/
+1 SEX M
+0 {segundo} INDI
+1 NAME Joao /Silva/
+1 SEX M
+"""
+
+_CAUDA = """0 @I3@ INDI
+1 NAME Ana /Silva/
+0 @I4@ INDI
+1 NAME Ana /Souza/
+0 @I5@ INDI
+1 NAME Bruno /Silva/
+0 @I6@ INDI
+1 NAME Bruno /Souza/
+0 @I1@ INDI
+1 NAME Alvo /Um/
+1 FAMC @F30@
+0 @I2@ INDI
+1 NAME Alvo /Dois/
+1 FAMC @F32@
+0 @F10@ FAM
+1 HUSB @I10@
+1 CHIL @I3@
+1 CHIL @I5@
+0 @F20@ FAM
+1 WIFE @I20@
+1 CHIL @I4@
+1 CHIL @I6@
+0 @F30@ FAM
+1 HUSB @I3@
+1 WIFE @I4@
+1 CHIL @I1@
+0 @F32@ FAM
+1 HUSB @I5@
+1 WIFE @I6@
+1 CHIL @I2@
+0 TRLR
+"""
+
+
+def _montar(primeiro: str, segundo: str) -> str:
+    return _CABECA + _CORPO_ANCESTRAIS.format(primeiro=primeiro, segundo=segundo) + _CAUDA
+
+
+def _gravar(conteudo: str) -> str:
+    fd, caminho = tempfile.mkstemp(suffix=".ged")
+    with os.fdopen(fd, "w", encoding="utf-8") as fh:
+        fh.write(conteudo)
+    return caminho
+
+
+@pytest.fixture()
+def duas_declaracoes():
+    caminhos = [_gravar(_montar("@I10@", "@I20@")), _gravar(_montar("@I20@", "@I10@"))]
+    yield caminhos
+    for caminho in caminhos:
+        try:
+            os.unlink(caminho)
+        except OSError:
+            pass
+
+
+def test_o_empate_triplo_e_desempatado_pelo_menor_xref_id(duas_declaracoes):
+    for caminho in duas_declaracoes:
+        arvore = gedcom_parser.carregar_arvore(caminho)
+        comuns = dr.find_all_common_ancestors(arvore, "@I1@", "@I2@")
+
+        ids = [c["id"] for c in comuns]
+        assert ids == ["@I10@", "@I20@"], (
+            "no empate em meioses, distancia e nome, a ordem tem de ser a dos ids"
+        )
+
+        # O empate tem de ser REAL — senao o teste nao estaria medindo o quarto
+        # criterio, e sim um dos tres primeiros.
+        primeiro, segundo = comuns[0], comuns[1]
+        assert primeiro["total_meioses"] == segundo["total_meioses"] == 4
+        assert max(primeiro["distance_a"], primeiro["distance_b"]) == 2
+        assert max(segundo["distance_a"], segundo["distance_b"]) == 2
+        assert primeiro["name"] == segundo["name"] == "Joao Silva"
+
+
+def test_a_ordem_nao_depende_da_ordem_de_declaracao_no_arquivo(duas_declaracoes):
+    ordens = []
+    for caminho in duas_declaracoes:
